{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/memory-graph-hook.mjs commit",
            "timeout": 60,
            "statusMessage": "Regenerating memory graph"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/memory-graph-hook.mjs session",
            "timeout": 60,
            "statusMessage": "Loading memory graph"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/memory-graph-hook.mjs session",
            "timeout": 60,
            "statusMessage": "Reloading memory graph"
          }
        ]
      }
    ]
  }
}
