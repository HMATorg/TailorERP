/// Fabric held at checkout and deducted at the cutting station (v4 Phase 2).
/// Reserving rather than deducting stops walk-in sales from consuming metres
/// already promised to a production order.
model FabricReservation {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId      String            @map("batch_id") @db.Uuid
  orderItemId  String            @map("order_item_id") @db.Uuid
  meters       Decimal           @db.Decimal(12, 2)
  status       ReservationStatus @default(reserved)
  reservedById String?           @map("reserved_by") @db.Uuid
  consumedAt   DateTime?         @map("consumed_at")
  releasedAt   DateTime?         @map("released_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([orderItemId])
  @@map("fabric_reservations")
}

/// One card per garment on the workshop Kanban (v4 Phase 4). A three-thobe
/// order produces three tickets that move through stations independently.
model ProductionTicket {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  orderItemId  String            @unique @map("order_item_id") @db.Uuid
  storeId      String            @map("store_id") @db.Uuid
  /// Scanned at each station — printed on the physical card
  ticketCode   String            @unique @map("ticket_code") @db.VarChar(50)
  station      ProductionStation @default(queued)
  assignedToId String?           @map("assigned_to") @db.Uuid
  startedAt    DateTime?         @map("started_at")
  completedAt  DateTime?         @map("completed_at")
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  order      Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem  OrderItem                @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  store      Store                    @relation(fields: [storeId], references: [id])
  assignedTo User?                    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  history    ProductionTicketHistory[]

  @@index([storeId, station])
  @@index([orderId])
  @@index([assignedToId])
  @@map("production_tickets")
}

model ProductionTicketHistory {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String             @map("ticket_id") @db.Uuid
  fromStation ProductionStation? @map("from_station")
  toStation   ProductionStation  @map("to_station")
  changedById String?            @map("changed_by") @db.Uuid
  note        String?
  createdAt   DateTime           @default(now()) @map("created_at")

  ticket    ProductionTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User?            @relation("TicketHistoryActor", fields: [changedById], references: [id])

  @@index([ticketId, createdAt])
  @@index([changedById])
  @@map("production_ticket_history")
}

// ────────────────────────────── Orders ───────────────────────────────

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  storeId        String      @map("store_id") @db.Uuid
  customerId     String      @map("customer_id") @db.Uuid
  orderNumber    String      @map("order_number") @db.VarChar(50)
  status         OrderStatus @default(pending)
  totalAmount    Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  paidAmount     Decimal     @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueDate        DateTime?   @map("due_date") @db.Date
  deliveredAt    DateTime?   @map("delivered_at")
  /// Rush order flag (D-055) — read off a real tailor shop's order form ("مستعجل")
  isUrgent       Boolean     @default(false) @map("is_urgent")
  notes          String?
  createdById    String?     @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id])
  store         Store                @relation(fields: [storeId], references: [id])
  customer      Customer             @relation(fields: [customerId], references: [id])
  createdBy     User?                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  invoice       Invoice?
  movements     InventoryMovement[]
  whatsappMessages WhatsappMessage[]
  tickets       ProductionTicket[]

  @@unique([storeId, orderNumber])
  @@index([storeId, customerId, createdAt])
  @@index([storeId, status])
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_order_number_trgm_idx")
  // NOTE: the dashboard aggregation also relies on a *partial* covering index
  // (orders_store_created_active_idx) that Prisma cannot express — it lives in
  // migration 20260725010000 and must not be dropped. See D-024.
  @@index([customerId])
  @@index([createdById])
  @@index([organizationId])
  @@map("orders")
}

/// A shop's own physical button stock (D-071) — admin photographs and
/// numbers each button they carry, mirroring the paper reference boards real
/// tailor shops already keep pinned by the counter. Distinct from
/// `OrderItem.cufflinkSize` (a manufacturing dimension like "9x3"): this is
/// *which* button design was picked from the shop's own catalog, not how big
/// it is. Org-wide, not per-store — the same button stock serves every branch.
model ButtonDesign {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// The number written on the shop's physical reference board (e.g. "153").
  /// Not a database identity — two different physical buttons a shop retired
  /// and later reused a number for would just be two rows; nothing enforces
  /// real-world uniqueness beyond the shop's own bookkeeping discipline.
  serialNumber   String   @map("serial_number") @db.VarChar(20)
  /// A data URI, same storage choice as Organization.logoUrl (D-069) — a
  /// small catalog thumbnail with no need for S3's signed-URL machinery.
  imageUrl       String   @map("image_url")
  label          String?  @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId, isActive])
  @@map("button_designs")
}

model OrderItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  garmentType   String   @map("garment_type") @db.VarChar(100)
  description   String?
  quantity      Int      @default(1)
  unitPrice     Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  measurementId String?  @map("measurement_id") @db.Uuid

  /// Position within the order — "Suit 1 of 3" (v4 amendment §4)
  sequenceNo    Int      @default(1) @map("sequence_no")

  // Design configuration flag vector — what the workshop actually builds
  collarStyle    CollarStyle?    @map("collar_style")
  cuffStyle      CuffStyle?      @map("cuff_style")
  pocketStyle    PocketStyle?    @map("pocket_style")
  stitchingStyle StitchingStyle? @map("stitching_style")
  /// Regional cut (D-055) — optional, Thobe-oriented; meaningless for Trousers etc.
  cutStyle       CutStyle?       @map("cut_style")
  /// Free text (e.g. "9x3") — a manufacturing spec, not a body measurement, so it
  /// doesn't belong in the Measurement matrix (D-055)
  cufflinkSize   String?         @map("cufflink_size") @db.VarChar(20)
  /// Which of the shop's own catalogued buttons to use (D-071) — separate
  /// from cufflinkSize above, which is a dimension, not a design choice.
  buttonDesignId String?         @map("button_design_id") @db.Uuid

  /// Fabric metres computed by the yield formula and held against a roll
  yieldMeters   Decimal? @map("yield_meters") @db.Decimal(12, 2)

  createdAt     DateTime @default(now()) @map("created_at")

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  measurement Measurement?      @relation(fields: [measurementId], references: [id])
  buttonDesign ButtonDesign?    @relation(fields: [buttonDesignId], references: [id])
  fabrics     OrderItemFabric[]
  reservations FabricReservation[]
  ticket      ProductionTicket?

  @@index([orderId])
  @@index([measurementId])
  @@index([buttonDesignId])
  @@map("order_items")
}

/// Links FIFO batch consumption to order items (which batch, how much, at what cost).
model OrderItemFabric {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId      String   @map("order_item_id") @db.Uuid
  batchId          String   @map("batch_id") @db.Uuid
  quantityUsed     Decimal  @map("quantity_used") @db.Decimal(12, 2)
  costPerUnitAtUse Decimal? @map("cost_per_unit_at_use") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batch     InventoryBatch @relation(fields: [batchId], references: [id])

  @@index([orderItemId])
  @@index([batchId])
  @@map("order_item_fabrics")
}

/// Powers the PWA tracking timeline timestamps (wireframes §3.6b).
model OrderStatusHistory {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  note        String?
  changedById String?      @map("changed_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([orderId, createdAt])
  @@index([changedById])
  @@map("order_status_history")
}

model Payment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(cash)
  /// Deposits are a liability until the goods are handed over (v4 Phase 3)
  kind         PaymentKind   @default(settlement)
  reference    String?       @db.VarChar(255)
  receivedById String?       @map("received_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  order      Order @relation(fields: [orderId], references: [id])
  receivedBy User? @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([orderId])
  @@index([receivedById])
  @@map("payments")
}

/// ZATCA Fatoora Phase 2 master file (v4 amendment §3).
/// Amounts are stored net / VAT / gross explicitly — the regulation requires all
/// three on the document, and deriving them at render time invites drift.
model Invoice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  orderId           String    @unique @map("order_id") @db.Uuid
  invoiceNumber     String    @map("invoice_number") @db.VarChar(50)

  // ── Tax block ──
  /// Net of VAT
  netAmount         Decimal   @default(0) @map("net_amount") @db.Decimal(12, 2)
  /// 15% KSA standard rate at time of issue; stored, not assumed
  vatRate           Decimal   @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount         Decimal   @default(0) @map("vat_amount") @db.Decimal(12, 2)
  /// Gross = net + VAT. Kept as totalAmount for backwards compatibility.
  totalAmount       Decimal   @map("total_amount") @db.Decimal(12, 2)

  // ── ZATCA compliance block ──
  zatcaInvoiceType  ZatcaInvoiceType @default(simplified) @map("zatca_invoice_type")
  /// Invoice UUID (distinct from our PK) carried in the UBL document
  zatcaUuid         String?   @unique @map("zatca_uuid") @db.Uuid
  /// Invoice Counter Value — monotonic per device, never reused
  icv               Int?
  /// SHA-256 of this invoice's canonical XML, base64
  invoiceHash       String?   @map("invoice_hash") @db.VarChar(128)
  /// Previous Invoice Hash — the chain link making the ledger tamper-evident
  previousHash      String?   @map("previous_hash") @db.VarChar(128)
  /// Base64 TLV payload rendered as the mandatory QR block
  qrCodeBase64      String?   @map("qr_code_base64")
  /// Signed UBL 2.1 document as submitted
  xmlUrl            String?   @map("xml_url")
  submissionStatus  ZatcaSubmissionStatus @default(pending) @map("submission_status")
  submittedAt       DateTime? @map("submitted_at")
  clearanceStatus   String?   @map("clearance_status") @db.VarChar(50)
  zatcaResponse     Json?     @map("zatca_response")

  pdfUrl            String?   @map("pdf_url")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  sentViaWhatsappAt DateTime? @map("sent_via_whatsapp_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, icv])
  @@index([organizationId, submissionStatus])
  @@map("invoices")
}

/// Chart of accounts, per organisation (v4 Phase 3 §2).
model LedgerAccount {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// Stable machine key the posting rules reference, e.g. 'cash_on_hand'
  code           String        @db.VarChar(50)
  name           String        @db.VarChar(255)
  nameAr         String?       @map("name_ar") @db.VarChar(255)
  type           AccountType
  normalBalance  NormalBalance @map("normal_balance")
  isSystem       Boolean       @default(true) @map("is_system")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        LedgerLine[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("ledger_accounts")
}

/// A balanced journal entry. Its lines must sum debits == credits, enforced in
/// LedgerService and asserted by a CHECK on the stored totals.
model JournalEntry {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  storeId        String?       @map("store_id") @db.Uuid
  /// Sequential per organisation — a gap means an entry was deleted
  entryNumber    Int           @map("entry_number")
  source         JournalSource
  /// What triggered this: an order, a payment…
  referenceType  String?       @map("reference_type") @db.VarChar(50)
  referenceId    String?       @map("reference_id") @db.Uuid
  memo           String?
  totalDebit     Decimal       @map("total_debit") @db.Decimal(14, 2)
  totalCredit    Decimal       @map("total_credit") @db.Decimal(14, 2)
  postedAt       DateTime      @default(now()) @map("posted_at")
  postedById     String?       @map("posted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postedBy     User?        @relation("JournalPostedBy", fields: [postedById], references: [id])
  lines        LedgerLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, postedAt])
  @@index([referenceType, referenceId])
  @@index([storeId])
  @@index([postedById])
  @@map("journal_entries")
}

model LedgerLine {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId   String  @map("entry_id") @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  /// Exactly one of debit/credit is non-zero on any given line
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  memo      String?

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("ledger_lines")
}


/// Atomic document numbering (D-038). `count(*) + 1` races under concurrent
/// checkouts: every transaction reads the same count and writes the same
/// number, so all but one hit the unique constraint and 500. A counter row
/// incremented with UPDATE … RETURNING serialises on its own row lock.
model DocumentCounter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// null for org-wide sequences such as invoice numbers
  storeId        String?  @map("store_id") @db.Uuid
  /// 'order' | 'invoice' | 'ticket'
  kind           String   @db.VarChar(30)
  /// Scopes the sequence, e.g. the year for invoice numbering
  scope          String   @default("") @db.VarChar(30)
  value          Int      @default(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([organizationId, storeId, kind, scope])
  @@map("document_counters")
}

// ─────────────────────────── WhatsApp ────────────────────────────────

