// Tailonix platform schema — implements TRD §3 plus base tables per D-003.
// Conventions: UUID PKs (gen_random_uuid), snake_case table/column mapping,
// Decimal(12,2) for quantities/money, JSONB for flexible payloads.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum OrgStatus {
  active
  suspended
}

enum StoreStatus {
  active
  paused
  closed
}

enum OrgRole {
  hq_admin
}

enum StoreRole {
  regional_manager
  store_manager
  tailor
  cashier
}

enum PlatformAdminLevel {
  super_admin
  billing
  support
}

enum OrderStatus {
  pending
  cutting
  sewing
  fitting
  ready
  delivered
  cancelled
}

enum AppointmentType {
  measurement
  first_fitting
  final_fitting
  pickup
}

enum AppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum BatchStatus {
  available
  depleted
  quarantined
}

enum MovementType {
  purchase_in
  order_out
  transfer_out
  transfer_in
  adjustment
  return_in
}

enum AlertStatus {
  pending
  acknowledged
  ordered
  resolved
}

enum PaymentMethod {
  cash
  card
  transfer
  other
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
}

enum WaMessageStatus {
  queued
  sent
  delivered
  read
  failed
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

// ─────────────────────── Organization & Stores ───────────────────────

model Organization {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String    @db.VarChar(255)
  logoUrl         String?   @map("logo_url")
  taxId           String?   @map("tax_id") @db.VarChar(100)
  defaultCurrency String    @default("SAR") @map("default_currency") @db.VarChar(10)
  timezone        String    @default("Asia/Riyadh") @db.VarChar(50)
  status          OrgStatus @default(active)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  stores           Store[]
  users            User[]
  customers        Customer[]
  suppliers        Supplier[]
  invitations      Invitation[]
  subscription     OrganizationSubscription?
  orders           Order[]
  invoices         Invoice[]
  whatsappMessages WhatsappMessage[]
  auditLogs        AuditLog[]

  @@map("organizations")
}

model Store {
  id                           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId               String      @map("organization_id") @db.Uuid
  name                         String      @db.VarChar(255)
  address                      String?
  phone                        String?     @db.VarChar(50)
  email                        String?     @db.VarChar(255)
  isHeadquarters               Boolean     @default(false) @map("is_headquarters")
  status                       StoreStatus @default(active)
  timezone                     String?     @db.VarChar(50) // D-008: falls back to organization timezone
  whatsappPhoneNumberId        String?     @map("whatsapp_phone_number_id") @db.VarChar(50)
  whatsappAccessTokenEncrypted String?     @map("whatsapp_access_token_encrypted")
  operatingHours               Json        @default("{}") @map("operating_hours")
  createdAt                    DateTime    @default(now()) @map("created_at")
  updatedAt                    DateTime    @default(now()) @updatedAt @map("updated_at")

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userStoreRoles     UserStoreRole[]
  customerVisits     CustomerStoreVisit[]
  preferredCustomers Customer[]               @relation("CustomerPreferredStore")
  appointments       Appointment[]
  batches            InventoryBatch[]
  reorderSettings    InventoryReorderSetting[]
  restockAlerts      InventoryRestockAlert[]
  orders             Order[]
  measurements       Measurement[]
  whatsappMessages   WhatsappMessage[]

  @@index([organizationId])
  @@map("stores")
}

// ─────────────────────────── Users & Roles ───────────────────────────

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  fullName       String?  @map("full_name") @db.VarChar(255)
  phone          String?  @db.VarChar(50)
  organizationId String?  @map("organization_id") @db.Uuid // null for platform staff
  orgRole        OrgRole? @map("org_role") // D-004: hq_admin is org-scoped
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization       Organization?           @relation(fields: [organizationId], references: [id])
  storeRoles         UserStoreRole[]
  platformAdmin      PlatformAdmin?
  measurementsTaken  Measurement[]           @relation("MeasurementTakenBy")
  appointmentsAssigned Appointment[]         @relation("AppointmentTailor")
  movementsCreated   InventoryMovement[]     @relation("MovementCreatedBy")
  alertsResolved     InventoryRestockAlert[] @relation("AlertResolvedBy")
  ordersCreated      Order[]                 @relation("OrderCreatedBy")
  statusChanges      OrderStatusHistory[]    @relation("StatusChangedBy")
  paymentsReceived   Payment[]               @relation("PaymentReceivedBy")
  invitationsSent    Invitation[]            @relation("InvitationInvitedBy")
  auditLogs          AuditLog[]              @relation("AuditActor")
  notifications      Notification[]

  @@index([organizationId])
  @@map("users")
}

model UserStoreRole {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  role        StoreRole
  permissions Json      @default("{}") // { grant: Permission[], revoke: Permission[] }
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId, storeId, isActive])
  @@map("user_store_roles")
}

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(255)
  fullName       String?          @map("full_name") @db.VarChar(255)
  phone          String?          @db.VarChar(50)
  orgRole        OrgRole?         @map("org_role")
  assignments    Json             @default("[]") // [{ storeId, role, permissions? }]
  token          String           @unique @db.VarChar(255)
  status         InvitationStatus @default(pending)
  expiresAt      DateTime         @map("expires_at")
  invitedById    String?          @map("invited_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@map("invitations")
}

// ──────────────────────────── Customers ──────────────────────────────

model Customer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  fullName         String   @map("full_name") @db.VarChar(255)
  phone            String   @db.VarChar(20) // login identity for PWA (D-013)
  email            String?  @db.VarChar(255)
  whatsappConsent  Boolean  @default(false) @map("whatsapp_consent")
  whatsappPhone    String?  @map("whatsapp_phone") @db.VarChar(20)
  preferredStoreId String?  @map("preferred_store_id") @db.Uuid
  language         String   @default("en") @db.VarChar(5)
  notes            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferredStore   Store?               @relation("CustomerPreferredStore", fields: [preferredStoreId], references: [id])
  visits           CustomerStoreVisit[]
  devices          CustomerDevice[]
  measurements     Measurement[]
  appointments     Appointment[]
  orders           Order[]
  whatsappMessages WhatsappMessage[]

  @@unique([organizationId, phone])
  @@map("customers")
}

model CustomerStoreVisit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  lastVisitDate DateTime @default(now()) @map("last_visit_date")
  notes         String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([customerId, storeId])
  @@map("customer_store_visits")
}

model CustomerDevice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  deviceToken String   @map("device_token") // web-push subscription JSON
  platform    String   @default("web") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isActive])
  @@map("customer_devices")
}

model Measurement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  storeId     String?  @map("store_id") @db.Uuid
  garmentType String   @map("garment_type") @db.VarChar(100)
  data        Json // { collar: 15.5, chest: 40, ... } unit: inches
  notes       String?
  takenById   String?  @map("taken_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store?   @relation(fields: [storeId], references: [id])
  takenBy  User?    @relation("MeasurementTakenBy", fields: [takenById], references: [id])
  orderItems OrderItem[]

  @@index([customerId, garmentType, createdAt])
  @@map("measurements")
}

// ─────────────────────────── Appointments ────────────────────────────

model Appointment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  storeId          String            @map("store_id") @db.Uuid
  assignedTailorId String?           @map("assigned_tailor_id") @db.Uuid
  appointmentType  AppointmentType   @map("appointment_type")
  scheduledAt      DateTime          @map("scheduled_at")
  durationMinutes  Int               @default(30) @map("duration_minutes")
  status           AppointmentStatus @default(scheduled)
  notes            String?
  cancelReason     String?           @map("cancel_reason")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignedTailor User?    @relation("AppointmentTailor", fields: [assignedTailorId], references: [id])

  @@index([storeId, assignedTailorId, scheduledAt])
  @@index([storeId, scheduledAt])
  @@map("appointments")
}

// ──────────────────────── Inventory & Suppliers ──────────────────────

model Supplier {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(255)
  contactPerson  String? @map("contact_person") @db.VarChar(255)
  phone          String? @db.VarChar(50)
  email          String? @db.VarChar(255)
  paymentTerms   String? @map("payment_terms") @db.VarChar(100)
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      InventoryBatch[]

  @@index([organizationId])
  @@map("suppliers")
}

model InventoryBatch {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String      @map("store_id") @db.Uuid
  supplierId          String?     @map("supplier_id") @db.Uuid
  fabricName          String      @map("fabric_name") @db.VarChar(255)
  fabricCode          String?     @map("fabric_code") @db.VarChar(100)
  batchCode           String      @map("batch_code") @db.VarChar(100)
  color               String?     @db.VarChar(50)
  unit                String      @default("meter") @db.VarChar(20)
  initialQuantity     Decimal     @map("initial_quantity") @db.Decimal(12, 2)
  currentQuantity     Decimal     @map("current_quantity") @db.Decimal(12, 2)
  costPricePerUnit    Decimal     @map("cost_price_per_unit") @db.Decimal(12, 2)
  sellingPricePerUnit Decimal?    @map("selling_price_per_unit") @db.Decimal(12, 2)
  purchaseDate        DateTime    @map("purchase_date") @db.Date
  expiryDate          DateTime?   @map("expiry_date") @db.Date
  storageLocation     String?     @map("storage_location") @db.VarChar(100)
  status              BatchStatus @default(available)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier  Supplier?           @relation(fields: [supplierId], references: [id])
  movements InventoryMovement[]
  orderItemFabrics OrderItemFabric[]

  // D-002: batch_code unique per store, NOT globally (transfers preserve codes)
  @@unique([storeId, batchCode])
  // FIFO query path (TRD §9)
  @@index([storeId, fabricName, purchaseDate, status])
  @@map("inventory_batches")
}

model InventoryMovement {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId           String       @map("batch_id") @db.Uuid
  orderId           String?      @map("order_id") @db.Uuid
  movementType      MovementType @map("movement_type")
  quantity          Decimal      @db.Decimal(12, 2)
  previousBalance   Decimal      @map("previous_balance") @db.Decimal(12, 2)
  newBalance        Decimal      @map("new_balance") @db.Decimal(12, 2)
  referenceDocument String?      @map("reference_document") @db.VarChar(255)
  note              String?
  createdById       String?      @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")

  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  order     Order?         @relation(fields: [orderId], references: [id])
  createdBy User?          @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([batchId, createdAt])
  @@map("inventory_movements")
}

model InventoryReorderSetting {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String  @map("store_id") @db.Uuid
  fabricName   String  @map("fabric_name") @db.VarChar(255)
  minThreshold Decimal @map("min_threshold") @db.Decimal(12, 2)
  maxThreshold Decimal? @map("max_threshold") @db.Decimal(12, 2)
  leadTimeDays Int     @default(7) @map("lead_time_days")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fabricName])
  @@map("inventory_reorder_settings")
}

model InventoryRestockAlert {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId           String      @map("store_id") @db.Uuid
  fabricName        String      @map("fabric_name") @db.VarChar(255)
  currentQty        Decimal?    @map("current_qty") @db.Decimal(12, 2)
  thresholdQty      Decimal?    @map("threshold_qty") @db.Decimal(12, 2)
  suggestedOrderQty Decimal?    @map("suggested_order_qty") @db.Decimal(12, 2)
  status            AlertStatus @default(pending)
  createdAt         DateTime    @default(now()) @map("created_at")
  resolvedAt        DateTime?   @map("resolved_at")
  resolvedById      String?     @map("resolved_by") @db.Uuid
  resolutionNote    String?     @map("resolution_note")

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("AlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([storeId, status])
  @@map("inventory_restock_alerts")
}

// ────────────────────────────── Orders ───────────────────────────────

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  storeId        String      @map("store_id") @db.Uuid
  customerId     String      @map("customer_id") @db.Uuid
  orderNumber    String      @map("order_number") @db.VarChar(50)
  status         OrderStatus @default(pending)
  totalAmount    Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  paidAmount     Decimal     @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueDate        DateTime?   @map("due_date") @db.Date
  deliveredAt    DateTime?   @map("delivered_at")
  notes          String?
  createdById    String?     @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id])
  store         Store                @relation(fields: [storeId], references: [id])
  customer      Customer             @relation(fields: [customerId], references: [id])
  createdBy     User?                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  invoice       Invoice?
  movements     InventoryMovement[]
  whatsappMessages WhatsappMessage[]

  @@unique([storeId, orderNumber])
  @@index([storeId, customerId, createdAt])
  @@index([storeId, status])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  garmentType   String   @map("garment_type") @db.VarChar(100)
  description   String?
  quantity      Int      @default(1)
  unitPrice     Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  measurementId String?  @map("measurement_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  measurement Measurement?      @relation(fields: [measurementId], references: [id])
  fabrics     OrderItemFabric[]

  @@index([orderId])
  @@map("order_items")
}

/// Links FIFO batch consumption to order items (which batch, how much, at what cost).
model OrderItemFabric {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId      String   @map("order_item_id") @db.Uuid
  batchId          String   @map("batch_id") @db.Uuid
  quantityUsed     Decimal  @map("quantity_used") @db.Decimal(12, 2)
  costPerUnitAtUse Decimal? @map("cost_per_unit_at_use") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batch     InventoryBatch @relation(fields: [batchId], references: [id])

  @@index([orderItemId])
  @@index([batchId])
  @@map("order_item_fabrics")
}

/// Powers the PWA tracking timeline timestamps (wireframes §3.6b).
model OrderStatusHistory {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  note        String?
  changedById String?      @map("changed_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(cash)
  reference    String?       @db.VarChar(255)
  receivedById String?       @map("received_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  order      Order @relation(fields: [orderId], references: [id])
  receivedBy User? @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([orderId])
  @@map("payments")
}

model Invoice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  orderId           String    @unique @map("order_id") @db.Uuid
  invoiceNumber     String    @map("invoice_number") @db.VarChar(50)
  totalAmount       Decimal   @map("total_amount") @db.Decimal(12, 2)
  pdfUrl            String?   @map("pdf_url")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  sentViaWhatsappAt DateTime? @map("sent_via_whatsapp_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

// ─────────────────────────── WhatsApp ────────────────────────────────

model WhatsappTemplate {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String  @db.VarChar(100)
  language   String  @db.VarChar(10)
  category   String  @db.VarChar(50)
  content    String
  headerType String? @map("header_type") @db.VarChar(20)
  isActive   Boolean @default(true) @map("is_active")

  @@unique([name, language])
  @@map("whatsapp_templates")
}

model WhatsappMessage {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  storeId        String          @map("store_id") @db.Uuid
  customerId     String          @map("customer_id") @db.Uuid
  orderId        String?         @map("order_id") @db.Uuid
  messageType    String          @map("message_type") @db.VarChar(30) // order_update | pickup_ready | invoice
  referenceId    String?         @map("reference_id") @db.Uuid
  waMessageId    String?         @map("wa_message_id") @db.VarChar(100)
  status         WaMessageStatus @default(queued)
  payload        Json?
  errorMessage   String?         @map("error_message")
  sentAt         DateTime?       @map("sent_at")
  deliveredAt    DateTime?       @map("delivered_at")
  readAt         DateTime?       @map("read_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@index([storeId, createdAt])
  @@index([waMessageId])
  @@map("whatsapp_messages")
}

// ──────────────────── Audit, Notifications, Tokens ───────────────────

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  storeId        String?  @map("store_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorType      String   @default("staff") @map("actor_type") @db.VarChar(30) // staff|platform_admin|impersonation|customer|system
  action         String   @db.VarChar(100)
  entityType     String?  @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id") @db.Uuid
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  ip             String?  @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  actorUser    User?         @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  storeId        String?   @map("store_id") @db.Uuid
  type           String    @db.VarChar(50)
  title          String    @db.VarChar(255)
  body           String?
  data           Json?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Rotating refresh tokens for staff, customers, and platform admins (polymorphic).
model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectType String    @map("subject_type") @db.VarChar(20) // staff|customer|platform
  subjectId   String    @map("subject_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  ip          String?   @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@map("refresh_tokens")
}

// ───────────────────── Platform Administration ───────────────────────

model PlatformAdmin {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String             @unique @map("user_id") @db.Uuid
  adminLevel PlatformAdminLevel @default(support) @map("admin_level")
  isActive   Boolean            @default(true) @map("is_active")
  createdAt  DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("platform_admins")
}

model SubscriptionPlan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(50)
  maxStores    Int      @default(1) @map("max_stores")
  maxUsers     Int      @default(10) @map("max_users")
  features     Json     @default("[]")
  monthlyPrice Decimal? @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice  Decimal? @map("yearly_price") @db.Decimal(10, 2)
  isPublic     Boolean  @default(true) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions OrganizationSubscription[]

  @@map("subscription_plans")
}

model OrganizationSubscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @unique @map("organization_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(active)
  trialEndsAt          DateTime?          @map("trial_ends_at")
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  stripeSubscriptionId String?            @map("stripe_subscription_id") @db.VarChar(255)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("organization_subscriptions")
}
