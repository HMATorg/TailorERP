// Tailonix platform schema — implements TRD §3 plus base tables per D-003.
// Conventions: UUID PKs (gen_random_uuid), snake_case table/column mapping,
// Decimal(12,2) for quantities/money, JSONB for flexible payloads.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgTrgm(map: "pg_trgm")]
}

// ─────────────────────────────── Enums ───────────────────────────────

enum OrgStatus {
  active
  suspended
}

enum StoreStatus {
  active
  paused
  closed
}

enum OrgRole {
  hq_admin
}

enum StoreRole {
  regional_manager
  store_manager
  tailor
  cashier
}

enum PlatformAdminLevel {
  super_admin
  billing
  support
}

enum OrderStatus {
  pending
  cutting
  sewing
  fitting
  ready
  delivered
  cancelled
}

enum AppointmentType {
  measurement
  first_fitting
  final_fitting
  pickup
}

enum AppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum BatchStatus {
  available
  depleted
  quarantined
}

enum MovementType {
  purchase_in
  order_out
  transfer_out
  transfer_in
  adjustment
  return_in
}

enum AlertStatus {
  pending
  acknowledged
  ordered
  resolved
}

enum PaymentMethod {
  cash
  card
  transfer
  other
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
}

enum WaMessageStatus {
  queued
  sent
  delivered
  read
  failed
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

// ─────────────── v4 amendment: garment design variants ───────────────
// Names follow the competitor blueprint's Saudi thobe terminology.

enum CollarStyle {
  qallabi_1_button
  qallabi_2_button
  rounded_sada
  open_v_neck
}

enum CuffStyle {
  formal_kabak // takes cufflinks
  buttoned_sada
}

enum PocketStyle {
  upper_left_patch
  hidden_side
  mobile_slot
}

enum StitchingStyle {
  hidden_plain
  visible_dual_sawai
  embroidered_zari
}

/// Regional thobe cut (D-055) — read off a real tailor shop's order form.
/// Deliberately just the three regions we could confidently read; `other`
/// covers the fourth option on that form until its exact name is confirmed.
enum CutStyle {
  saudi
  kuwaiti
  qatari
  other
}

/// Workshop stations (Kanban columns) — التفصيل / الخياطة / الكوي والجودة
enum ProductionStation {
  queued
  cutting
  stitching
  quality
  ready
}

enum ReservationStatus {
  reserved
  consumed
  released
}

/// ZATCA distinguishes B2C (simplified) from B2B (standard) invoices.
enum ZatcaInvoiceType {
  simplified
  standard
}

enum ZatcaSubmissionStatus {
  pending
  reported
  cleared
  failed
}

enum PaymentKind {
  deposit
  settlement
  refund
}

// ──────────────── v4: double-entry ledger (Phase 3 §2) ────────────────

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

/// Normal balance side. Assets/expenses increase with debits; liabilities,
/// equity and revenue increase with credits.
enum NormalBalance {
  debit
  credit
}

enum JournalSource {
  deposit
  settlement
  refund
  adjustment
}

// ─────────────────────── Organization & Stores ───────────────────────

model Organization {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String    @db.VarChar(255)
  logoUrl         String?   @map("logo_url")
  taxId           String?   @map("tax_id") @db.VarChar(100)
  /// 15-digit KSA VAT registration number, required on ZATCA invoices
  vatNumber       String?   @map("vat_number") @db.VarChar(20)
  /// Commercial Registration number (رقم السجل التجاري), printed on receipts
  /// and the A4 invoice alongside the VAT number — not a ZATCA XML/QR field,
  /// display only (D-069)
  crNumber        String?   @map("cr_number") @db.VarChar(50)
  /// Municipal/business license number (رقم الرخصة), display only (D-069)
  licenseNumber   String?   @map("license_number") @db.VarChar(50)
  /// Free-text liability/policy note (e.g. "not responsible for garments
  /// left unclaimed after 3 months") printed on the thermal receipt when
  /// set — shop-specific policy, so it is opt-in per tenant, not fixed
  /// product copy (D-072)
  receiptNote     String?   @map("receipt_note") @db.VarChar(500)
  /// ZATCA-issued CSID + private key for cryptographic stamping (encrypted)
  zatcaCsidEncrypted       String? @map("zatca_csid_encrypted")
  zatcaPrivateKeyEncrypted String? @map("zatca_private_key_encrypted")
  /// The secret ZATCA returns alongside a Compliance/Production CSID — paired
  /// with the certificate as HTTP Basic Auth against the Reporting/Clearance
  /// APIs (encrypted, D-057)
  zatcaApiSecretEncrypted  String? @map("zatca_api_secret_encrypted")
  /// Onboarding stage of the CSID currently on file: "compliance" (bootstrap
  /// credential, usable only for compliance-check calls) or "production"
  /// (usable for real Reporting/Clearance). Null before onboarding starts.
  /// D-058.
  zatcaEnvironment String?  @map("zatca_environment") @db.VarChar(20)
  /// ZATCA's own id for the compliance CSID request — required to request
  /// the Production CSID afterwards (D-058)
  zatcaComplianceRequestId String? @map("zatca_compliance_request_id")
  defaultCurrency String    @default("SAR") @map("default_currency") @db.VarChar(10)
  timezone        String    @default("Asia/Riyadh") @db.VarChar(50)
  status          OrgStatus @default(active)
  stripeCustomerId String?  @unique @map("stripe_customer_id") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  stores           Store[]
  users            User[]
  customers        Customer[]
  suppliers        Supplier[]
  invitations      Invitation[]
  subscription     OrganizationSubscription?
  orders           Order[]
  invoices         Invoice[]
  whatsappMessages WhatsappMessage[]
  auditLogs        AuditLog[]
  ledgerAccounts   LedgerAccount[]
  journalEntries   JournalEntry[]
  buttonDesigns    ButtonDesign[]

  @@map("organizations")
}

model Store {
  id                           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId               String      @map("organization_id") @db.Uuid
  name                         String      @db.VarChar(255)
  address                      String?
  phone                        String?     @db.VarChar(50)
  email                        String?     @db.VarChar(255)
  isHeadquarters               Boolean     @default(false) @map("is_headquarters")
  status                       StoreStatus @default(active)
  timezone                     String?     @db.VarChar(50) // D-008: falls back to organization timezone
  whatsappPhoneNumberId        String?     @map("whatsapp_phone_number_id") @db.VarChar(50)
  whatsappAccessTokenEncrypted String?     @map("whatsapp_access_token_encrypted")
  operatingHours               Json        @default("{}") @map("operating_hours")
  createdAt                    DateTime    @default(now()) @map("created_at")
  updatedAt                    DateTime    @default(now()) @updatedAt @map("updated_at")

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userStoreRoles     UserStoreRole[]
  customerVisits     CustomerStoreVisit[]
  preferredCustomers Customer[]               @relation("CustomerPreferredStore")
  appointments       Appointment[]
  batches            InventoryBatch[]
  reorderSettings    InventoryReorderSetting[]
  restockAlerts      InventoryRestockAlert[]
  orders             Order[]
  measurements       Measurement[]
  whatsappMessages   WhatsappMessage[]
  productionTickets  ProductionTicket[]

  @@index([organizationId])
  @@map("stores")
}

// ─────────────────────────── Users & Roles ───────────────────────────

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  fullName       String?  @map("full_name") @db.VarChar(255)
  phone          String?  @db.VarChar(50)
  organizationId String?  @map("organization_id") @db.Uuid // null for platform staff
  orgRole        OrgRole? @map("org_role") // D-004: hq_admin is org-scoped
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization       Organization?           @relation(fields: [organizationId], references: [id])
  storeRoles         UserStoreRole[]
  platformAdmin      PlatformAdmin?
  measurementsTaken  Measurement[]           @relation("MeasurementTakenBy")
  appointmentsAssigned Appointment[]         @relation("AppointmentTailor")
  movementsCreated   InventoryMovement[]     @relation("MovementCreatedBy")
  alertsResolved     InventoryRestockAlert[] @relation("AlertResolvedBy")
  ordersCreated      Order[]                 @relation("OrderCreatedBy")
  statusChanges      OrderStatusHistory[]    @relation("StatusChangedBy")
  paymentsReceived   Payment[]               @relation("PaymentReceivedBy")
  invitationsSent    Invitation[]            @relation("InvitationInvitedBy")
  auditLogs          AuditLog[]              @relation("AuditActor")
  notifications      Notification[]
  ticketsAssigned    ProductionTicket[]        @relation("TicketAssignee")
  ticketChanges      ProductionTicketHistory[] @relation("TicketHistoryActor")
  journalEntries     JournalEntry[]           @relation("JournalPostedBy")

  @@index([organizationId])
  @@map("users")
}

model UserStoreRole {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  role        StoreRole
  permissions Json      @default("{}") // { grant: Permission[], revoke: Permission[] }
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId, storeId, isActive])
  @@index([storeId])
  @@map("user_store_roles")
}

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(255)
  fullName       String?          @map("full_name") @db.VarChar(255)
  phone          String?          @db.VarChar(50)
  orgRole        OrgRole?         @map("org_role")
  assignments    Json             @default("[]") // [{ storeId, role, permissions? }]
  token          String           @unique @db.VarChar(255)
  status         InvitationStatus @default(pending)
  expiresAt      DateTime         @map("expires_at")
  invitedById    String?          @map("invited_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([invitedById])
  @@map("invitations")
}

// ──────────────────────────── Customers ──────────────────────────────

model Customer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  fullName         String   @map("full_name") @db.VarChar(255)
  phone            String   @db.VarChar(20) // login identity for PWA (D-013)
  email            String?  @db.VarChar(255)
  whatsappConsent  Boolean  @default(false) @map("whatsapp_consent")
  whatsappPhone    String?  @map("whatsapp_phone") @db.VarChar(20)
  preferredStoreId String?  @map("preferred_store_id") @db.Uuid
  language         String   @default("en") @db.VarChar(5)
  /// The customer's own VAT registration number, for a B2B sale where the
  /// buyer needs it on the tax invoice (D-069). Not the seller's — that's
  /// Organization.vatNumber.
  vatNumber        String?  @map("vat_number") @db.VarChar(20)
  address          String?
  /// Lifetime garment count driving tier level (v4 amendment §1)
  lifetimeOrderCount Int    @default(0) @map("lifetime_order_count")
  notes            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferredStore   Store?               @relation("CustomerPreferredStore", fields: [preferredStoreId], references: [id])
  visits           CustomerStoreVisit[]
  devices          CustomerDevice[]
  measurements     Measurement[]
  appointments     Appointment[]
  orders           Order[]
  whatsappMessages WhatsappMessage[]

  @@unique([organizationId, phone])
  // Substring search (ILIKE '%…%') cannot use a B-tree — see D-025
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_full_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_phone_trgm_idx")
  @@index([preferredStoreId])
  @@map("customers")
}

model CustomerStoreVisit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  lastVisitDate DateTime @default(now()) @map("last_visit_date")
  notes         String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([customerId, storeId])
  @@index([storeId])
  @@map("customer_store_visits")
}

model CustomerDevice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  deviceToken String   @map("device_token") // web-push subscription JSON
  platform    String   @default("web") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isActive])
  @@map("customer_devices")
}

/// Versioned measurement snapshot (v4 amendment §2). All dimensions in
/// CENTIMETRES. Exactly one profile per customer+garmentType may be active —
/// enforced by a partial unique index — so cutters always work from one frame.
model Measurement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  storeId     String?  @map("store_id") @db.Uuid
  garmentType String   @map("garment_type") @db.VarChar(100)
  /// Sequential snapshot version per customer+garmentType, starting at 1
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")

  // Body measurement points matrix, cm (M1–M8)
  // M1 and M3 (D-068) — a real tailor shop's front/back and left/right
  // measurements are not interchangeable: a robe's front and back panels are
  // legitimately cut to different lengths, and an asymmetric body needs each
  // sleeve measured on its own arm rather than assuming symmetry. The single
  // m1TotalLength/m3SleeveLength columns this replaces are gone, not kept
  // alongside these — see the migration for how existing rows were preserved.
  m1FrontLength   Decimal? @map("m1_front_length") @db.Decimal(6, 2) // الطول الأمامي
  m1BackLength    Decimal? @map("m1_back_length") @db.Decimal(6, 2) // الطول الخلفي
  m2ShoulderWidth Decimal? @map("m2_shoulder_width") @db.Decimal(6, 2) // الكتف
  m3SleeveLeft    Decimal? @map("m3_sleeve_left") @db.Decimal(6, 2) // الكم الأيسر
  m3SleeveRight   Decimal? @map("m3_sleeve_right") @db.Decimal(6, 2) // الكم الأيمن
  m4ChestCirc     Decimal? @map("m4_chest_circumference") @db.Decimal(6, 2) // الصدر
  m5HipWidth      Decimal? @map("m5_hip_width") @db.Decimal(6, 2) // الوسط
  m6NeckDiameter  Decimal? @map("m6_neck_diameter") @db.Decimal(6, 2) // الرقبة
  m7WristOpening  Decimal? @map("m7_wrist_opening") @db.Decimal(6, 2) // الوسع
  m8SkirtPerimeter Decimal? @map("m8_skirt_perimeter") @db.Decimal(6, 2) // الذيل

  // M9-M13 (D-055), added against a real tailor shop's own paper order form.
  // m5HipWidth above predates this and was captured as a combined "Waist/Hip"
  // point; m9Waist is the dedicated waist point going forward — historical
  // m5 values are not retroactively split, since which one a cashier meant
  // isn't recoverable.
  m9Waist         Decimal? @map("m9_waist") @db.Decimal(6, 2) // الوسط (waist, distinct from hip)
  m10RoundShoulder Decimal? @map("m10_round_shoulder") @db.Decimal(6, 2) // الكتف المدور
  m11MidHand      Decimal? @map("m11_mid_hand") @db.Decimal(6, 2) // منتصف اليد
  m12PlateLength  Decimal? @map("m12_plate_length") @db.Decimal(6, 2) // طول اللوح
  m13HalfChest    Decimal? @map("m13_half_chest") @db.Decimal(6, 2) // نصف الصدر

  // Trousers points, T1-T7 (D-054). Not a robe — no sleeve/neck/hem in the
  // M1-M8 sense, so it gets its own matrix rather than force-fitting values
  // into columns named for a thobe's construction.
  t1Waist         Decimal? @map("t1_waist") @db.Decimal(6, 2) // الخصر
  t2Hip           Decimal? @map("t2_hip") @db.Decimal(6, 2) // الورك
  t3Inseam        Decimal? @map("t3_inseam") @db.Decimal(6, 2) // الداخلي
  t4Outseam       Decimal? @map("t4_outseam") @db.Decimal(6, 2) // الطول الكلي
  t5Thigh         Decimal? @map("t5_thigh") @db.Decimal(6, 2) // الفخذ
  t6Knee          Decimal? @map("t6_knee") @db.Decimal(6, 2) // الركبة
  t7AnkleOpening  Decimal? @map("t7_ankle_opening") @db.Decimal(6, 2) // فتحة الأسفل

  /// Trousers/shalwar palla (waist pleat) widths (D-068) — a variable-count
  /// list, not fixed columns: how many pleats a shalwar has is a per-garment
  /// choice, not a fixed matrix point like T1-T7. Array of {label, valueCm}.
  trouserPallas Json? @map("trouser_pallas")

  /// Any additional shop-specific points that do not fit the standard matrix
  extra       Json?
  notes       String?
  takenById   String?  @map("taken_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store?   @relation(fields: [storeId], references: [id])
  takenBy  User?    @relation("MeasurementTakenBy", fields: [takenById], references: [id])
  orderItems OrderItem[]

  @@unique([customerId, garmentType, version])
  @@index([customerId, garmentType, createdAt])
  @@index([customerId, isActive])
  @@index([storeId])
  @@index([takenById])
  @@map("measurements")
}

// ─────────────────────────── Appointments ────────────────────────────

model Appointment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  storeId          String            @map("store_id") @db.Uuid
  assignedTailorId String?           @map("assigned_tailor_id") @db.Uuid
  appointmentType  AppointmentType   @map("appointment_type")
  scheduledAt      DateTime          @map("scheduled_at")
  durationMinutes  Int               @default(30) @map("duration_minutes")
  status           AppointmentStatus @default(scheduled)
  notes            String?
  cancelReason     String?           @map("cancel_reason")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignedTailor User?    @relation("AppointmentTailor", fields: [assignedTailorId], references: [id])

  @@index([storeId, assignedTailorId, scheduledAt])
  @@index([storeId, scheduledAt])
  @@index([customerId])
  @@index([assignedTailorId])
  @@map("appointments")
}

// ──────────────────────── Inventory & Suppliers ──────────────────────

model Supplier {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(255)
  contactPerson  String? @map("contact_person") @db.VarChar(255)
  phone          String? @db.VarChar(50)
  email          String? @db.VarChar(255)
  paymentTerms   String? @map("payment_terms") @db.VarChar(100)
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      InventoryBatch[]

  @@index([organizationId])
  @@map("suppliers")
}

model InventoryBatch {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String      @map("store_id") @db.Uuid
  supplierId          String?     @map("supplier_id") @db.Uuid
  fabricName          String      @map("fabric_name") @db.VarChar(255)
  fabricCode          String?     @map("fabric_code") @db.VarChar(100)
  batchCode           String      @map("batch_code") @db.VarChar(100)
  color               String?     @db.VarChar(50)
  unit                String      @default("meter") @db.VarChar(20)
  initialQuantity     Decimal     @map("initial_quantity") @db.Decimal(12, 2)
  currentQuantity     Decimal     @map("current_quantity") @db.Decimal(12, 2)
  costPricePerUnit    Decimal     @map("cost_price_per_unit") @db.Decimal(12, 2)
  sellingPricePerUnit Decimal?    @map("selling_price_per_unit") @db.Decimal(12, 2)
  purchaseDate        DateTime    @map("purchase_date") @db.Date
  expiryDate          DateTime?   @map("expiry_date") @db.Date
  storageLocation     String?     @map("storage_location") @db.VarChar(100)
  status              BatchStatus @default(available)

  // ── v4 amendment §5: manufacturer trace + fractional roll control ──
  /// Barcode on the physical shelf label
  barcode        String? @db.VarChar(100)
  brand          String? @db.VarChar(100)
  /// e.g. "Toyobo Japan"
  origin         String? @db.VarChar(100)
  fabricTypeName String? @map("fabric_type") @db.VarChar(100)
  colorShadeCode String? @map("color_shade_code") @db.VarChar(50)
  /// Below this remainder the roll leaves storefront availability for adult
  /// thobes — a sellability rule, distinct from the reorder threshold.
  minUsableMeters Decimal @default(3.50) @map("min_usable_meters") @db.Decimal(12, 2)
  /// Metres held for orders not yet cut; available = current − reserved
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(12, 2)

  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier  Supplier?           @relation(fields: [supplierId], references: [id])
  movements InventoryMovement[]
  orderItemFabrics OrderItemFabric[]
  reservations FabricReservation[]

  // D-002: batch_code unique per store, NOT globally (transfers preserve codes)
  @@unique([storeId, batchCode])
  @@index([storeId, barcode])
  // FIFO query path (TRD §9)
  @@index([storeId, fabricName, purchaseDate, status])
  @@index([supplierId])
  @@map("inventory_batches")
}

model InventoryMovement {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId           String       @map("batch_id") @db.Uuid
  orderId           String?      @map("order_id") @db.Uuid
  movementType      MovementType @map("movement_type")
  quantity          Decimal      @db.Decimal(12, 2)
  previousBalance   Decimal      @map("previous_balance") @db.Decimal(12, 2)
  newBalance        Decimal      @map("new_balance") @db.Decimal(12, 2)
  referenceDocument String?      @map("reference_document") @db.VarChar(255)
  note              String?
  createdById       String?      @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")

  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  order     Order?         @relation(fields: [orderId], references: [id])
  createdBy User?          @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([batchId, createdAt])
  @@index([createdById])
  @@index([orderId])
  @@map("inventory_movements")
}

model InventoryReorderSetting {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String  @map("store_id") @db.Uuid
  fabricName   String  @map("fabric_name") @db.VarChar(255)
  minThreshold Decimal @map("min_threshold") @db.Decimal(12, 2)
  maxThreshold Decimal? @map("max_threshold") @db.Decimal(12, 2)
  leadTimeDays Int     @default(7) @map("lead_time_days")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fabricName])
  @@map("inventory_reorder_settings")
}

model InventoryRestockAlert {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId           String      @map("store_id") @db.Uuid
  fabricName        String      @map("fabric_name") @db.VarChar(255)
  currentQty        Decimal?    @map("current_qty") @db.Decimal(12, 2)
  thresholdQty      Decimal?    @map("threshold_qty") @db.Decimal(12, 2)
  suggestedOrderQty Decimal?    @map("suggested_order_qty") @db.Decimal(12, 2)
  status            AlertStatus @default(pending)
  createdAt         DateTime    @default(now()) @map("created_at")
  resolvedAt        DateTime?   @map("resolved_at")
  resolvedById      String?     @map("resolved_by") @db.Uuid
  resolutionNote    String?     @map("resolution_note")

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("AlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([storeId, status])
  @@index([resolvedById])
